# SPECTER optional keys. Copy to .env and fill in what you obtain.
# Every module works without these; keys only add depth or higher limits.

# GitHub token: Free: 5,000 req/hour with a token (60 without).
#   get it: https://github.com/settings/tokens
GITHUB_TOKEN=

# Have I Been Pwned key: Paid subscription; the keyless XposedOrNot index covers breaches for free.
#   get it: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# SearXNG base URL: Free public instances, no key needed.
#   get it: https://searx.space/
SEARXNG_URL=

# Google API key: Free: 100 queries/day, no card.
#   get it: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=

# Google CSE id: Free: created with the search engine.
#   get it: https://programmablesearchengine.google.com/controlpanel/create
GOOGLE_CSE_ID=

# Brave Search key: Free plan: 2,000 queries/month (card may be requested).
#   get it: https://api-dashboard.search.brave.com/app/subscriptions
BRAVE_API_KEY=

# CourtListener token: Free token for registered users.
#   get it: https://www.courtlistener.com/help/api/rest/
COURTLISTENER_TOKEN=

# Numverify key: Free: 100 requests/month.
#   get it: https://numverify.com/signup
NUMVERIFY_API_KEY=

# IPinfo token: Free: 50,000 requests/month.
#   get it: https://ipinfo.io/signup
IPINFO_TOKEN=

# Shodan key: Free account: limited query credits.
#   get it: https://account.shodan.io/register
SHODAN_API_KEY=

# OpenCorporates key: Free API account, rate-limited.
#   get it: https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_KEY=

# EmailRep key: Free key, rate-limited.
#   get it: https://emailrep.io/key
EMAILREP_API_KEY=
